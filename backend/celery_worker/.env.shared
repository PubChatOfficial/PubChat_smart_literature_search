# -----------------------------------------------------------------------------
# Environment variables for PubMed Meta-Analysis Workflow
#
# Instructions:
# 1. Copy this file to a new file named .env in the same directory.
# 2. Fill in the values for the variables below.
# 3. DO NOT commit the .env file to version control.
# -----------------------------------------------------------------------------

# (Optional but Recommended) Your NCBI API Key for PubMed.
# This provides a higher request rate limit.
# You can obtain one from your NCBI account settings after logging in.
# See: https://www.ncbi.nlm.nih.gov/books/NBK25497/#chapter2.Getting_an_API_Key
# -----------------------------------------------------------------------------
# Workflow Configuration
# -----------------------------------------------------------------------------

# AI Provider - 支持数字或字符串格式
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 国际主流                                                                     │
# │   1=gemini (Google), 2=claude (Anthropic), 3=openai, 4=deepseek, 5=grok     │
# │ 国内厂商                                                                     │
# │   6=qwen (通义千问), 7=moonshot (Kimi), 8=glm (智谱), 9=baichuan, 10=yi       │
# │ 聚合平台                                                                     │
# │   11=openrouter, 12=groq, 13=siliconflow, 14=together, 15=fireworks         │
# │ 其他                                                                        │
# │   16=mistral, 17=perplexity, 18=cohere                                      │
# │ 本地模型                                                                     │
# │   19=ollama, 20=lmstudio, 21=gcli2api                                       │
# └─────────────────────────────────────────────────────────────────────────────┘
# 示例: AI_PROVIDER=1 或 AI_PROVIDER=gemini (两种格式均可)
# AI_PROVIDER='gemini'

#Maximum number of search refinement attempts
MAX_REFINEMENT_ATTEMPTS=30

#Minimum number of studies to find before stopping
MIN_STUDY_THRESHOLD=100

# Maximum number of parallel AI workers for article screening
AI_MAX_WORKERS=60

#Output language: 1=中文, 2=English, 3=Español, 4=Français, 5=Português, 6=Italiano, 7=Deutsch, 8=Русский
OUTPUT_LANGUAGE='zh'

# Batch size for processing PMIDs
BATCH_SIZE=600

# -----------------------------------------------------------------------------
# Embedding prefilter configuration
# -----------------------------------------------------------------------------
# Enable/disable the embedding prefilter. Set to false to route all articles
# directly to the LLM screening path.
EMBEDDING_ENABLED=true

# Initial Gemini Embedding 2 threshold. Native Google Gemini embedding-2 testing
# showed this keeps roughly 99% of score=3 articles while filtering many
# score=0/1/2 articles. Revalidate separately for OpenRouter embeddings.
EMBEDDING_SIMILARITY_THRESHOLD=0.75

# Embedding sub-batch size and concurrency. The first 4 batches start
# immediately; after 3 seconds, up to 8 embedding batches may run concurrently.
EMBEDDING_BATCH_SIZE=50
EMBEDDING_INITIAL_CONCURRENCY=4
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_RAMP_DELAY_SECONDS=3

# Retry/timeout/backpressure controls for embedding requests.
EMBEDDING_MAX_RETRIES=2
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_BACKPRESSURE_LIMIT=240

# Provider-specific model defaults.
GOOGLE_GEMINI_PRO_MODEL=gemini-flash-lite-latest
GOOGLE_GEMINI_FLASH_MODEL=gemini-flash-lite-latest
OPENROUTER_GEMINI_PRO_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_GEMINI_FLASH_MODEL=google/gemini-3.1-flash-lite-preview
GOOGLE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENROUTER_GEMINI_EMBEDDING_MODEL=google/gemini-embedding-2-preview
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Prevent transient 5xx/network errors from retrying forever inside one API call.
AI_TRANSIENT_MAX_RETRIES_PER_ROUND=6

# 去数据库请求API的配置文件
BASE_URL_API =  http://api-server:8000/
